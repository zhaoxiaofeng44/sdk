.*
!.gitignore

# Build outputs
build/
*.o
*.so
*.dylib

# Temporary files
*_temp.dart
*_temp.*
*.dill

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.cache/
compile_commands.json

# OS
.DS_Store
Thumbs.db

# Dependencies
.dart_tool/
.packages
pubspec.lock

# Test outputs
test_output/
*.log

# C++ build artifacts
cpp/build/
cpp/*.o
cpp/core/*.o
cpp/test/*_test
!cpp/test/*_test.cpp
cpp/test/.backup_*/

# Compiled binaries
a.out
*.exe

# Temporary tools
tool/*_temp.dart
tool/test_*.dart
