  24   auto result1 = DART_AWAIT(immediateFuture);
  25   dart_print(dart_string("  立即Future: ") + (result1).toString());
  26   auto delayedFuture = Future::delayed(ObjectPtr<Duration>(new Duration(dart_int(0), dart_int(0), dart_int(0), dart_int(0), dart_int(100), dart_int(0))), makeFunction([&]() { return dart_string("延迟完成"); }));
  27   auto result2 = DART_AWAIT(delayedFuture);
