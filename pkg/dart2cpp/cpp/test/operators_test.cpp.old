// ============================================================================
// C++ 运算符重载测试用例
// 测试各种运算符在联合体结构下的正确工作
// 注意：使用联合体 ValueUnion 访问 .value.int_value, .value.double_value 等
// 基于实际的运算符实现进行测试
// ============================================================================

#include "../core/dart2cpp.h"
#include <iostream>
#include <cassert>
#include <cmath>
#include <stdexcept>

// 简单的测试框架
#define TEST(name) \
    void test_##name(); \
    void test_##name()

#define ASSERT_EQ(expected, actual) \
    do { \
        if ((expected) != (actual)) { \
            std::cerr << "ASSERTION FAILED: " << #expected << " != " << #actual \
                      << " (expected: " << (expected) << ", actual: " << (actual) << ")" \
                      << " at " << __FILE__ << ":" << __LINE__ << std::endl; \
            std::abort(); \
        } \
    } while(0)

#define ASSERT_TRUE(condition) \
    do { \
        if (!(condition)) { \
            std::cerr << "ASSERTION FAILED: " << #condition << " is false" \
                      << " at " << __FILE__ << ":" << __LINE__ << std::endl; \
            std::abort(); \
        } \
    } while(0)

#define ASSERT_FALSE(condition) \
    do { \
        if (condition) { \
            std::cerr << "ASSERTION FAILED: " << #condition << " is true" \
                      << " at " << __FILE__ << ":" << __LINE__ << std::endl; \
            std::abort(); \
        } \
    } while(0)

#define ASSERT_NEAR(expected, actual, tolerance) \
    do { \
        if (std::abs((expected) - (actual)) > (tolerance)) { \
            std::cerr << "ASSERTION FAILED: " << #expected << " != " << #actual \
                      << " (expected: " << (expected) << ", actual: " << (actual) \
                      << ", tolerance: " << (tolerance) << ")" \
                      << " at " << __FILE__ << ":" << __LINE__ << std::endl; \
            std::abort(); \
        } \
    } while(0)

#define RUN_TEST(name) \
    do { \
        std::cout << "Running test_" << #name << "..." << std::endl; \
        test_##name(); \
        std::cout << "✓ test_" << #name << " passed" << std::endl; \
    } while(0)

// ============================================================================
// Int 算术运算符测试
// ============================================================================

TEST(int_arithmetic_operators) {
    Int a(15);
    Int b(4);
    
    // 加法运算符
    Int sum = a + b;
    ASSERT_EQ(19, sum.value.int_value);
    
    // 减法运算符
    Int diff = a - b;
    ASSERT_EQ(11, diff.value.int_value);
    
    // 乘法运算符
    Int product = a * b;
    ASSERT_EQ(60, product.value.int_value);
    
    // 除法运算符
    Int quotient = a / b;
    ASSERT_EQ(3, quotient.value.int_value);
    
    // 取模运算符
    Int remainder = a % b;
    ASSERT_EQ(3, remainder.value.int_value);
    
    // 一元负号（使用方法调用）
    Int negative = a.operator_negate();
    ASSERT_EQ(-15, negative.value.int_value);
    
    // 一元正号（使用方法调用）
    Int positive = a.operator_unary_plus();
    ASSERT_EQ(15, positive.value.int_value);
}

TEST(int_comparison_operators) {
    Int a(10);
    Int b(20);
    Int c(10);
    
    // 相等比较
    Bool eq1 = (a == c);
    ASSERT_TRUE(eq1.value.bool_value);
    
    Bool eq2 = (a == b);
    ASSERT_FALSE(eq2.value.bool_value);
    
    // 不等比较（使用逻辑非和相等比较）
    Bool ne1 = (a == b);
    Bool ne1_result = ne1.operator!();
    ASSERT_TRUE(ne1_result.value.bool_value);
    
    Bool ne2 = (a == c);
    Bool ne2_result = ne2.operator!();
    ASSERT_FALSE(ne2_result.value.bool_value);
    
    // 大小比较
    Bool lt = (a < b);
    ASSERT_TRUE(lt.value.bool_value);
    
    Bool gt = (b > a);
    ASSERT_TRUE(gt.value.bool_value);
    
    Bool le1 = (a <= c);
    ASSERT_TRUE(le1.value.bool_value);
    
    Bool le2 = (a <= b);
    ASSERT_TRUE(le2.value.bool_value);
    
    Bool ge1 = (b >= a);
    ASSERT_TRUE(ge1.value.bool_value);
    
    Bool ge2 = (c >= a);
    ASSERT_TRUE(ge2.value.bool_value);
}

TEST(int_compound_assignment_operators) {
    Int value(10);
    
    // 加法赋值
    value += Int(5);
    ASSERT_EQ(15, value.value.int_value);
    
    // 减法赋值
    value -= Int(3);
    ASSERT_EQ(12, value.value.int_value);
    
    // 乘法赋值
    value *= Int(2);
    ASSERT_EQ(24, value.value.int_value);
    
    // 除法赋值
    value /= Int(3);
    ASSERT_EQ(8, value.value.int_value);
    
    // 取模赋值
    value %= Int(3);
    ASSERT_EQ(2, value.value.int_value);
}

TEST(int_increment_decrement_operators) {
    Int value(5);
    
    // 前置自增
    Int pre_inc = ++value;
    ASSERT_EQ(6, pre_inc.value.int_value);
    ASSERT_EQ(6, value.value.int_value);
    
    // 后置自增
    Int post_inc = value++;
    ASSERT_EQ(6, post_inc.value.int_value);  // 返回原值
    ASSERT_EQ(7, value.value.int_value);     // value 已增加
    
    // 前置自减
    Int pre_dec = --value;
    ASSERT_EQ(6, pre_dec.value.int_value);
    ASSERT_EQ(6, value.value.int_value);
    
    // 后置自减
    Int post_dec = value--;
    ASSERT_EQ(6, post_dec.value.int_value);  // 返回原值
    ASSERT_EQ(5, value.value.int_value);     // value 已减少
}

// ============================================================================
// Double 算术运算符测试
// ============================================================================

TEST(double_arithmetic_operators) {
    Double a(15.5);
    Double b(4.2);
    
    // 加法运算符
    Double sum = a + b;
    ASSERT_NEAR(19.7, sum.value.double_value, 0.001);
    
    // 减法运算符
    Double diff = a - b;
    ASSERT_NEAR(11.3, diff.value.double_value, 0.001);
    
    // 乘法运算符
    Double product = a * b;
    ASSERT_NEAR(65.1, product.value.double_value, 0.001);
    
    // 除法运算符
    Double quotient = a / b;
    ASSERT_NEAR(3.690, quotient.value.double_value, 0.001);
    
    // 取模运算符
    Double remainder = a % b;
    ASSERT_NEAR(2.9, remainder.value.double_value, 0.1);
    
    // 一元负号（使用方法调用）
    Double negative = a.operator_negate();
    ASSERT_NEAR(-15.5, negative.value.double_value, 0.001);
    
    // 一元正号（使用方法调用）
    Double positive = a.operator_unary_plus();
    ASSERT_NEAR(15.5, positive.value.double_value, 0.001);
}

TEST(double_comparison_operators) {
    Double a(10.5);
    Double b(20.7);
    Double c(10.5);
    
    // 相等比较
    Bool eq1 = (a == c);
    ASSERT_TRUE(eq1.value.bool_value);
    
    Bool eq2 = (a == b);
    ASSERT_FALSE(eq2.value.bool_value);
    
    // 不等比较（使用逻辑非和相等比较）
    Bool ne1_base = (a == b);
    Bool ne1 = ne1_base.operator!();
    ASSERT_TRUE(ne1.value.bool_value);
    
    Bool ne2_base = (a == c);
    Bool ne2 = ne2_base.operator!();
    ASSERT_FALSE(ne2.value.bool_value);
    
    // 大小比较
    Bool lt = (a < b);
    ASSERT_TRUE(lt.value.bool_value);
    
    Bool gt = (b > a);
    ASSERT_TRUE(gt.value.bool_value);
    
    Bool le = (a <= c);
    ASSERT_TRUE(le.value.bool_value);
    
    Bool ge = (b >= a);
    ASSERT_TRUE(ge.value.bool_value);
}

TEST(double_increment_decrement_operators) {
    Double value(2.5);
    
    // 前置自增
    Double pre_inc = ++value;
    ASSERT_NEAR(3.5, pre_inc.value.double_value, 0.001);
    ASSERT_NEAR(3.5, value.value.double_value, 0.001);
    
    // 后置自减
    Double post_dec = value--;
    ASSERT_NEAR(3.5, post_dec.value.double_value, 0.001);  // 返回原值
    ASSERT_NEAR(2.5, value.value.double_value, 0.001);     // value 已减少
}

TEST(double_compound_assignment_operators) {
    Double x(10.0);
    
    x += Double(2.5);
    ASSERT_NEAR(12.5, x.value.double_value, 0.001);
    
    x -= Double(1.5);
    ASSERT_NEAR(11.0, x.value.double_value, 0.001);
    
    x *= Double(2.0);
    ASSERT_NEAR(22.0, x.value.double_value, 0.001);
    
    x /= Double(4.0);
    ASSERT_NEAR(5.5, x.value.double_value, 0.001);
}

// ============================================================================
// Bool 逻辑运算符测试
// ============================================================================

TEST(bool_logical_operators) {
    Bool true_val(true);
    Bool false_val(false);
    
    // 逻辑与运算符
    Bool and_tt = true_val && true_val;
    ASSERT_TRUE(and_tt.value.bool_value);
    
    Bool and_tf = true_val && false_val;
    ASSERT_FALSE(and_tf.value.bool_value);
    
    Bool and_ft = false_val && true_val;
    ASSERT_FALSE(and_ft.value.bool_value);
    
    Bool and_ff = false_val && false_val;
    ASSERT_FALSE(and_ff.value.bool_value);
    
    // 逻辑或运算符
    Bool or_tt = true_val || true_val;
    ASSERT_TRUE(or_tt.value.bool_value);
    
    Bool or_tf = true_val || false_val;
    ASSERT_TRUE(or_tf.value.bool_value);
    
    Bool or_ft = false_val || true_val;
    ASSERT_TRUE(or_ft.value.bool_value);
    
    Bool or_ff = false_val || false_val;
    ASSERT_FALSE(or_ff.value.bool_value);
    
    // 逻辑非运算符（使用方法调用）
    Bool not_true = true_val.operator!();
    ASSERT_FALSE(not_true.value.bool_value);
    
    Bool not_false = false_val.operator!();
    ASSERT_TRUE(not_false.value.bool_value);
}

TEST(bool_comparison_operators) {
    Bool true_val(true);
    Bool false_val(false);
    Bool another_true(true);
    Bool another_false(false);
    
    // 相等比较
    Bool eq_tt = (true_val == another_true);
    ASSERT_TRUE(eq_tt.value.bool_value);
    
    Bool eq_ff = (false_val == another_false);
    ASSERT_TRUE(eq_ff.value.bool_value);
    
    Bool eq_tf = (true_val == false_val);
    ASSERT_FALSE(eq_tf.value.bool_value);
    
    // 不等比较（使用逻辑非和相等比较）
    Bool ne_tf_base = (true_val == false_val);
    Bool ne_tf = ne_tf_base.operator!();
    ASSERT_TRUE(ne_tf.value.bool_value);
    
    Bool ne_tt_base = (true_val == another_true);
    Bool ne_tt = ne_tt_base.operator!();
    ASSERT_FALSE(ne_tt.value.bool_value);
}

// ============================================================================
// String 运算符测试
// ============================================================================

TEST(string_concatenation_operators) {
    String hello("Hello");
    String space(" ");
    String world("World");
    String exclamation("!");
    
    // 字符串连接运算符
    String result1 = hello + space;
    ASSERT_EQ("Hello ", result1.getValue());
    
    String result2 = hello + space + world;
    ASSERT_EQ("Hello World", result2.getValue());
    
    String result3 = hello + space + world + exclamation;
    ASSERT_EQ("Hello World!", result3.getValue());
    
    // 与 Bool 连接
    Bool true_val(true);
    Bool false_val(false);
    String bool_concat1 = hello + true_val;
    ASSERT_EQ("Hellotrue", bool_concat1.getValue());
    
    String bool_concat2 = hello + false_val;
    ASSERT_EQ("Hellofalse", bool_concat2.getValue());
}

TEST(string_comparison_operators) {
    String apple("apple");
    String banana("banana");
    String apple2("apple");
    String empty("");
    
    // 相等比较
    Bool eq1 = (apple == apple2);
    ASSERT_TRUE(eq1.value.bool_value);
    
    Bool eq2 = (apple == banana);
    ASSERT_FALSE(eq2.value.bool_value);
    
    // 与字符串字面量比较
    Bool eq3 = (apple == "apple");
    ASSERT_TRUE(eq3.value.bool_value);
    
    Bool eq4 = (apple == "banana");
    ASSERT_FALSE(eq4.value.bool_value);
    
    // 不等比较（使用逻辑非和相等比较）
    Bool ne1_base = (apple == banana);
    Bool ne1 = ne1_base.operator!();
    ASSERT_TRUE(ne1.value.bool_value);
    
    Bool ne2_base = (apple == apple2);
    Bool ne2 = ne2_base.operator!();
    ASSERT_FALSE(ne2.value.bool_value);
    
    Bool ne3_base = (apple == "banana");
    Bool ne3 = ne3_base.operator!();
    ASSERT_TRUE(ne3.value.bool_value);
    
    // 大小比较（字典序）
    Bool lt1 = (apple < banana);
    ASSERT_TRUE(lt1.value.bool_value);
    
    Bool lt2 = (banana < apple);
    ASSERT_FALSE(lt2.value.bool_value);
    
    Bool gt1 = (banana > apple);
    ASSERT_TRUE(gt1.value.bool_value);
    
    Bool le1 = (apple <= apple2);
    ASSERT_TRUE(le1.value.bool_value);
    
    Bool ge1 = (apple >= apple2);
    ASSERT_TRUE(ge1.value.bool_value);
    
    // 空字符串比较
    Bool empty_lt = (empty < apple);
    ASSERT_TRUE(empty_lt.value.bool_value);
}

TEST(string_indexing_operator) {
    String text("Hello");
    
    // 索引访问
    String char0 = text[Int(0)];
    ASSERT_EQ("H", char0.getValue());
    
    String char1 = text[Int(1)];
    ASSERT_EQ("e", char1.getValue());
    
    String char4 = text[Int(4)];
    ASSERT_EQ("o", char4.getValue());
}

// ============================================================================
// 混合类型运算符测试
// ============================================================================

TEST(mixed_type_arithmetic_operators) {
    Int int_val(10);
    Double double_val(3.5);
    
    // Int 与 Double 的运算
    Double result1 = int_val + double_val;
    ASSERT_NEAR(13.5, result1.value.double_value, 0.001);
    
    Double result2 = int_val - double_val;
    ASSERT_NEAR(6.5, result2.value.double_value, 0.001);
    
    Double result3 = int_val * double_val;
    ASSERT_NEAR(35.0, result3.value.double_value, 0.001);
    
    Double result4 = int_val / double_val;
    ASSERT_NEAR(2.857, result4.value.double_value, 0.001);
    
    // 验证结果类型
    ASSERT_EQ(2, result1.type_id);  // 结果应该是 Double 类型
    ASSERT_EQ(2, result2.type_id);
    ASSERT_EQ(2, result3.type_id);
    ASSERT_EQ(2, result4.type_id);
}

TEST(mixed_type_comparison_operators) {
    Int int_val(10);
    Double double_val(10.0);
    Double different_double(10.5);
    
    // Int 与 Double 的比较（通过转换为相同类型）
    Bool eq1 = (int_val.toDouble() == double_val);
    ASSERT_TRUE(eq1.value.bool_value);
    
    Bool lt1 = (int_val.toDouble() < different_double);
    ASSERT_TRUE(lt1.value.bool_value);
    
    Bool gt1 = (different_double > int_val.toDouble());
    ASSERT_TRUE(gt1.value.bool_value);
}

// ============================================================================
// 运算符优先级测试
// ============================================================================

TEST(operator_precedence) {
    Int a(2);
    Int b(3);
    Int c(4);
    
    // 测试乘法优先于加法
    Int result1 = a + b * c;  // 应该是 2 + (3 * 4) = 14
    ASSERT_EQ(14, result1.value.int_value);
    
    // 测试括号改变优先级
    Int result2 = (a + b) * c;  // 应该是 (2 + 3) * 4 = 20
    ASSERT_EQ(20, result2.value.int_value);
    
    // 测试比较运算符优先级
    Bool cmp1 = (a < b);
    Bool cmp2 = (b < c);
    Bool result3 = cmp1 && cmp2;  // 应该是 (2 < 3) && (3 < 4) = true
    ASSERT_TRUE(result3.value.bool_value);
    
    Int left_side = a + b;  // 2 + 3 = 5
    Int right_side = c * b;  // 4 * 3 = 12
    Bool result4 = (left_side < right_side);  // 5 < 12 = true
    ASSERT_TRUE(result4.value.bool_value);
}

// ============================================================================
// 错误处理和边界情况测试
// ============================================================================

TEST(division_by_zero_operators) {
    Int positive(10);
    Int zero(0);
    
    // 整数除零错误
    bool caught_division_error = false;
    try {
        Int result = positive / zero;
    } catch (const std::runtime_error& e) {
        caught_division_error = true;
    }
    ASSERT_TRUE(caught_division_error);
    
    // 整数取模除零错误
    bool caught_modulo_error = false;
    try {
        Int result = positive % zero;
    } catch (const std::runtime_error& e) {
        caught_modulo_error = true;
    }
    ASSERT_TRUE(caught_modulo_error);
    
    // 复合赋值除零错误
    bool caught_compound_error = false;
    try {
        positive /= zero;
    } catch (const std::runtime_error& e) {
        caught_compound_error = true;
    }
    ASSERT_TRUE(caught_compound_error);
}

TEST(overflow_underflow_handling) {
    // 测试整数溢出情况
    Int max_int(INT_MAX);
    Int one(1);
    
    // 测试浮点数特殊值运算
    Double inf(std::numeric_limits<double>::infinity());
    Double normal(1.0);
    
    // 无穷大运算
    Double inf_plus_normal = inf + normal;
    Bool is_inf = inf_plus_normal.get_isInfinite();
    ASSERT_TRUE(is_inf.value.bool_value);
    
    // NaN 运算
    Double nan_val(std::numeric_limits<double>::quiet_NaN());
    Double nan_plus_normal = nan_val + normal;
    Bool is_nan = nan_plus_normal.get_isNaN();
    ASSERT_TRUE(is_nan.value.bool_value);
}

TEST(chained_operators) {
    Int a(1);
    Int b(2);
    Int c(3);
    Int d(4);
    
    // 链式运算
    Int result1 = a + b + c + d;  // 1 + 2 + 3 + 4 = 10
    ASSERT_EQ(10, result1.value.int_value);
    
    Int result2 = a * b + c * d;  // (1 * 2) + (3 * 4) = 2 + 12 = 14
    ASSERT_EQ(14, result2.value.int_value);
    
    // 链式比较
    Bool cmp1 = (a < b);
    Bool cmp2 = (b < c);
    Bool cmp3 = (c < d);
    Bool result3 = cmp1 && cmp2 && cmp3;
    ASSERT_TRUE(result3.value.bool_value);
    
    Bool eq1 = (a == Int(1));
    Bool eq2 = (b == Int(2));
    Bool eq3 = (c == Int(3));
    Bool result4 = eq1 && eq2 && eq3;
    ASSERT_TRUE(result4.value.bool_value);
}

// ============================================================================
// 主函数
// ============================================================================

int main() {
    std::cout << "=== 运算符重载测试开始 ===" << std::endl;
    std::cout << std::endl;
    
    std::cout << "--- Int 运算符测试 ---" << std::endl;
    RUN_TEST(int_arithmetic_operators);
    RUN_TEST(int_comparison_operators);
    RUN_TEST(int_compound_assignment_operators);
    RUN_TEST(int_increment_decrement_operators);
    std::cout << std::endl;
    
    std::cout << "--- Double 运算符测试 ---" << std::endl;
    RUN_TEST(double_arithmetic_operators);
    RUN_TEST(double_comparison_operators);
    RUN_TEST(double_increment_decrement_operators);
    RUN_TEST(double_compound_assignment_operators);
    std::cout << std::endl;
    
    std::cout << "--- Bool 运算符测试 ---" << std::endl;
    RUN_TEST(bool_logical_operators);
    RUN_TEST(bool_comparison_operators);
    std::cout << std::endl;
    
    std::cout << "--- String 运算符测试 ---" << std::endl;
    RUN_TEST(string_concatenation_operators);
    RUN_TEST(string_comparison_operators);
    RUN_TEST(string_indexing_operator);
    std::cout << std::endl;
    
    std::cout << "--- 混合类型运算符测试 ---" << std::endl;
    RUN_TEST(mixed_type_arithmetic_operators);
    RUN_TEST(mixed_type_comparison_operators);
    std::cout << std::endl;
    
    std::cout << "--- 运算符优先级测试 ---" << std::endl;
    RUN_TEST(operator_precedence);
    std::cout << std::endl;
    
    std::cout << "--- 错误处理和边界情况测试 ---" << std::endl;
    RUN_TEST(division_by_zero_operators);
    RUN_TEST(overflow_underflow_handling);
    RUN_TEST(chained_operators);
    std::cout << std::endl;
    
    std::cout << "=== 所有运算符重载测试通过! ===" << std::endl;
    
    return 0;
}
