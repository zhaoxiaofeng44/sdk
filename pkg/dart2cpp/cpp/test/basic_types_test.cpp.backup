// ============================================================================
// C++ 基础数据类型测试用例
// 测试 Int、Double、Bool、String 等基础类型的功能
// ============================================================================

#include "../core/object.h"
#include "../core/object_extensions.h"
#include "../core/dart_macros.h"
#include <iostream>
#include <cassert>
#include <cmath>
#include <stdexcept>

// 简单的测试框架
#define TEST(name) \
    void test_##name(); \
    void test_##name()

#define ASSERT_EQ(expected, actual) \
    do { \
        if ((expected) != (actual)) { \
            std::cerr << "ASSERTION FAILED: " << #expected << " != " << #actual \
                      << " (expected: " << (expected) << ", actual: " << (actual) << ")" \
                      << " at " << __FILE__ << ":" << __LINE__ << std::endl; \
            std::abort(); \
        } \
    } while(0)

#define ASSERT_TRUE(condition) \
    do { \
        if (!(condition)) { \
            std::cerr << "ASSERTION FAILED: " << #condition << " is false" \
                      << " at " << __FILE__ << ":" << __LINE__ << std::endl; \
            std::abort(); \
        } \
    } while(0)

#define ASSERT_FALSE(condition) \
    do { \
        if (condition) { \
            std::cerr << "ASSERTION FAILED: " << #condition << " is true" \
                      << " at " << __FILE__ << ":" << __LINE__ << std::endl; \
            std::abort(); \
        } \
    } while(0)

#define ASSERT_NEAR(expected, actual, tolerance) \
    do { \
        if (std::abs((expected) - (actual)) > (tolerance)) { \
            std::cerr << "ASSERTION FAILED: " << #expected << " != " << #actual \
                      << " within tolerance " << (tolerance) \
                      << " (expected: " << (expected) << ", actual: " << (actual) << ")" \
                      << " at " << __FILE__ << ":" << __LINE__ << std::endl; \
            std::abort(); \
        } \
    } while(0)

#define RUN_TEST(name) \
    do { \
        std::cout << "Running test_" << #name << "..." << std::endl; \
        test_##name(); \
        std::cout << "✓ test_" << #name << " passed" << std::endl; \
    } while(0)

// ============================================================================
// Int 类型测试
// ============================================================================

TEST(int_construction) {
    // 默认构造函数
    Int default_int;
    ASSERT_EQ(0, default_int.value.int_value);
    
    // 参数构造函数
    Int int_42(42);
    ASSERT_EQ(42, int_42.value.int_value);
    
    // 拷贝构造函数
    Int copied_int(int_42);
    ASSERT_EQ(42, copied_int.value.int_value);
    
    // 使用宏构造
    Int macro_int = dart_int(100);
    ASSERT_EQ(100, macro_int.value.int_value);
}

TEST(int_arithmetic_operations) {
    Int a(15);
    Int b(4);
    
    // 基本算术运算
    ASSERT_EQ(19, (a + b).value.int_value);
    ASSERT_EQ(11, (a - b).value.int_value);
    ASSERT_EQ(60, (a * b).value.int_value);
    ASSERT_EQ(3, (a / b).value.int_value);
    ASSERT_EQ(3, (a % b).value.int_value);
    
    // 整数除法
    ASSERT_EQ(3, a.integerDivision(b).value.int_value);
    
    // 一元运算符
    ASSERT_EQ(-15, a.operator_unary_minus().value.int_value);
    ASSERT_EQ(15, a.operator_unary_plus().value.int_value);
}

TEST(int_comparison_operations) {
    Int a(10);
    Int b(20);
    Int c(10);
    
    // 相等性比较
    ASSERT_TRUE((a == c).value.bool_value);
    ASSERT_FALSE((a == b).value.bool_value);
    ASSERT_TRUE((a != b).value.bool_value);
    ASSERT_FALSE((a != c).value.bool_value);
    
    // 大小比较
    ASSERT_TRUE((a < b).value.bool_value);
    ASSERT_TRUE((b > a).value.bool_value);
    ASSERT_TRUE((a <= c).value.bool_value);
    ASSERT_TRUE((b >= a).value.bool_value);
    ASSERT_FALSE((a > b).value.bool_value);
    ASSERT_FALSE((b < a).value.bool_value);
}

TEST(int_bitwise_operations) {
    Int a(12); // 1100 in binary
    Int b(10); // 1010 in binary
    
    // 位运算
    ASSERT_EQ(8, a.operator_bitwise_and(b).toInt());  // 1000 = 8
    ASSERT_EQ(14, a.operator_bitwise_or(b).toInt());  // 1110 = 14
    ASSERT_EQ(6, a.operator_bitwise_xor(b).toInt());  // 0110 = 6
    ASSERT_EQ(-13, a.operator_bitwise_not().toInt()); // ~12 = -13
    
    // 位移运算
    ASSERT_EQ(48, a.operator_shift_left(Int(2)).toInt());  // 12 << 2 = 48
    ASSERT_EQ(3, a.operator_shift_right(Int(2)).toInt());  // 12 >> 2 = 3
    
    // 无符号右移
    ASSERT_EQ(3, dart_unsigned_shift_right(a, Int(2)).toInt());
}

TEST(int_properties) {
    Int positive(42);
    Int negative(-17);
    Int zero(0);
    Int even(8);
    Int odd(7);
    
    // 符号属性
    ASSERT_EQ(1, positive.get_sign().toInt());
    ASSERT_EQ(-1, negative.get_sign().toInt());
    ASSERT_EQ(0, zero.get_sign().toInt());
    
    // 奇偶性
    ASSERT_TRUE(even.get_isEven());
    ASSERT_FALSE(even.get_isOdd());
    ASSERT_FALSE(odd.get_isEven());
    ASSERT_TRUE(odd.get_isOdd());
    
    // 负数检查
    ASSERT_TRUE(negative.get_isNegative());
    ASSERT_FALSE(positive.get_isNegative());
    
    // 有限性（整数总是有限的）
    ASSERT_TRUE(positive.get_isFinite());
    ASSERT_FALSE(positive.get_isInfinite());
    ASSERT_FALSE(positive.get_isNaN());
}

TEST(int_methods) {
    Int a(15);
    Int b(-25);
    Int c(12);
    Int d(18);
    
    // abs 方法
    ASSERT_EQ(15, a.abs().toInt());
    ASSERT_EQ(25, b.abs().toInt());
    
    // compareTo 方法
    ASSERT_EQ(-1, a.compareTo(Int(20)).toInt());
    ASSERT_EQ(0, a.compareTo(Int(15)).toInt());
    ASSERT_EQ(1, a.compareTo(Int(10)).toInt());
    
    // gcd 方法
    ASSERT_EQ(6, c.gcd(d).toInt()); // gcd(12, 18) = 6
    
    // 类型转换
    ASSERT_EQ(15, a.toInt());
    ASSERT_TRUE(a.toBool());
    ASSERT_FALSE(Int(0).toBool());
}

// ============================================================================
// Double 类型测试
// ============================================================================

TEST(double_construction) {
    // 默认构造函数
    Double default_double;
    ASSERT_EQ(0.0, default_double.toDouble());
    
    // 参数构造函数
    Double double_pi(3.14159);
    ASSERT_NEAR(3.14159, double_pi.toDouble(), 0.00001);
    
    // 从 Int 构造
    Int int_val(42);
    Double from_int(int_val);
    ASSERT_EQ(42.0, from_int.value.double_value);
    
    // 使用宏构造
    Double macro_double = dart_double(2.718);
    ASSERT_NEAR(2.718, macro_double.value.double_value, 0.001);
}

TEST(double_arithmetic_operations) {
    Double x(10.5);
    Double y(2.5);
    
    // 基本算术运算
    ASSERT_NEAR(13.0, (x + y).value.double_value, 0.001);
    ASSERT_NEAR(8.0, (x - y).value.double_value, 0.001);
    ASSERT_NEAR(26.25, (x * y).value.double_value, 0.001);
    ASSERT_NEAR(4.2, (x / y).value.double_value, 0.001);
    ASSERT_NEAR(0.5, (x % y).value.double_value, 0.001);
    
    // 一元运算符
    ASSERT_EQ(-10.5, x.operator_unary_minus().value.double_value);
    ASSERT_EQ(10.5, x.operator_unary_plus().value.double_value);
}

TEST(double_comparison_operations) {
    Double x(3.14);
    Double y(2.71);
    Double z(3.14);
    
    // 相等性比较
    ASSERT_TRUE((x == z).value.bool_value);
    ASSERT_TRUE((x != y).value.bool_value);
    
    // 大小比较
    ASSERT_TRUE((x > y).value.bool_value);
    ASSERT_TRUE((y < x).value.bool_value);
    ASSERT_TRUE((x >= z).value.bool_value);
    ASSERT_TRUE((x <= z).value.bool_value);
}

TEST(double_methods) {
    Double positive(42.7);
    Double negative(-17.3);
    Double decimal(3.14159);
    
    // abs 方法
    ASSERT_NEAR(42.7, positive.abs().value.double_value, 0.001);
    ASSERT_NEAR(17.3, negative.abs().value.double_value, 0.001);
    
    // 舍入方法
    ASSERT_EQ(3.0, decimal.floor().value.double_value);
    ASSERT_EQ(4.0, decimal.ceil().value.double_value);
    ASSERT_EQ(3.0, decimal.round().value.double_value);
    ASSERT_EQ(3.0, decimal.truncate().value.double_value);
    
    // 类型转换
    ASSERT_EQ(42, positive.toInt().value.int_value);
    ASSERT_NEAR(42.7, positive.toDouble(), 0.001);
    
    // 符号属性
    ASSERT_EQ(1, positive.get_sign().value.int_value);
    ASSERT_EQ(-1, negative.get_sign().value.int_value);
    ASSERT_TRUE(negative.get_isNegative().value.bool_value);
    ASSERT_FALSE(positive.get_isNegative().value.bool_value);
}

// ============================================================================
// Bool 类型测试
// ============================================================================

TEST(bool_construction) {
    // 默认构造函数
    Bool default_bool;
    ASSERT_FALSE(default_bool.value);
    
    // 参数构造函数
    Bool true_bool(true);
    Bool false_bool(false);
    ASSERT_TRUE(true_bool.value);
    ASSERT_FALSE(false_bool.value);
    
    // 使用宏构造
    Bool macro_true = dart_bool(true);
    Bool macro_false = dart_bool(false);
    ASSERT_TRUE(macro_true.value);
    ASSERT_FALSE(macro_false.value);
}

TEST(bool_logical_operations) {
    Bool t(true);
    Bool f(false);
    
    // 逻辑与
    ASSERT_TRUE((t && t).value);
    ASSERT_FALSE((t && f).value);
    ASSERT_FALSE((f && t).value);
    ASSERT_FALSE((f && f).value);
    
    // 逻辑或
    ASSERT_TRUE((t || t).value);
    ASSERT_TRUE((t || f).value);
    ASSERT_TRUE((f || t).value);
    ASSERT_FALSE((f || f).value);
    
    // 逻辑非
    ASSERT_FALSE((!t).value);
    ASSERT_TRUE((!f).value);
}

TEST(bool_comparison_operations) {
    Bool t1(true);
    Bool t2(true);
    Bool f(false);
    
    // 相等性比较
    ASSERT_TRUE((t1 == t2).value);
    ASSERT_TRUE((t1 != f).value);
    ASSERT_FALSE((t1 == f).value);
}

TEST(bool_methods) {
    Bool t(true);
    Bool f(false);
    
    // compareTo 方法
    ASSERT_EQ(0, t.compareTo(Bool(true)).value);
    ASSERT_EQ(1, t.compareTo(f).value);
    ASSERT_EQ(-1, f.compareTo(t).value);
    
    // 类型转换
    ASSERT_TRUE(t.toBool());
    ASSERT_FALSE(f.toBool());
    ASSERT_EQ(1, t.toInt().value);
    ASSERT_EQ(0, f.toInt().value);
    
    // 隐式转换为 bool
    ASSERT_TRUE(static_cast<bool>(t));
    ASSERT_FALSE(static_cast<bool>(f));
}

// ============================================================================
// 扩展操作符测试
// ============================================================================

TEST(increment_decrement_operators) {
    Int counter(5);
    
    // 前置自增
    Int pre_inc = ++counter;
    ASSERT_EQ(6, pre_inc.value);
    ASSERT_EQ(6, counter.value);
    
    // 后置自增
    Int post_inc = counter++;
    ASSERT_EQ(6, post_inc.value);  // 返回原值
    ASSERT_EQ(7, counter.value);   // counter 已增加
    
    // 前置自减
    Int pre_dec = --counter;
    ASSERT_EQ(6, pre_dec.value);
    ASSERT_EQ(6, counter.value);
    
    // 后置自减
    Int post_dec = counter--;
    ASSERT_EQ(6, post_dec.value);  // 返回原值
    ASSERT_EQ(5, counter.value);   // counter 已减少
}

TEST(compound_assignment_operators) {
    Int value(10);
    
    // 加法赋值
    value += Int(5);
    ASSERT_EQ(15, value.value);
    
    // 减法赋值
    value -= Int(3);
    ASSERT_EQ(12, value.value);
    
    // 乘法赋值
    value *= Int(2);
    ASSERT_EQ(24, value.value);
    
    // 除法赋值
    value /= Int(3);
    ASSERT_EQ(8, value.value);
    
    // 取模赋值
    value %= Int(3);
    ASSERT_EQ(2, value.value);
}

TEST(double_increment_decrement) {
    Double value(2.5);
    
    // 前置自增
    Double pre_inc = ++value;
    ASSERT_EQ(3.5, pre_inc.value);
    ASSERT_EQ(3.5, value.value);
    
    // 后置自减
    Double post_dec = value--;
    ASSERT_EQ(3.5, post_dec.value);  // 返回原值
    ASSERT_EQ(2.5, value.value);     // value 已减少
}

TEST(double_compound_assignment) {
    Double x(10.0);
    
    x += Double(2.5);
    ASSERT_NEAR(12.5, x.value, 0.001);
    
    x -= Double(1.5);
    ASSERT_NEAR(11.0, x.value, 0.001);
    
    x *= Double(2.0);
    ASSERT_NEAR(22.0, x.value, 0.001);
    
    x /= Double(4.0);
    ASSERT_NEAR(5.5, x.value, 0.001);
}

// ============================================================================
// 异常处理测试
// ============================================================================

TEST(division_by_zero_exceptions) {
    Int a(10);
    Int zero(0);
    
    bool caught_exception = false;
    try {
        Int result = a / zero;
    } catch (const std::runtime_error& e) {
        caught_exception = true;
        ASSERT_TRUE(std::string(e.what()).find("Division by zero") != std::string::npos);
    }
    ASSERT_TRUE(caught_exception);
    
    // 测试取模除零
    caught_exception = false;
    try {
        Int result = a % zero;
    } catch (const std::runtime_error& e) {
        caught_exception = true;
    }
    ASSERT_TRUE(caught_exception);
    
    // 测试复合赋值除零
    caught_exception = false;
    try {
        a /= zero;
    } catch (const std::runtime_error& e) {
        caught_exception = true;
    }
    ASSERT_TRUE(caught_exception);
}

// ============================================================================
// 主函数
// ============================================================================

int main() {
    std::cout << "=== C++ 基础数据类型测试 ===" << std::endl;
    
    // Int 类型测试
    std::cout << "\n--- Int 类型测试 ---" << std::endl;
    RUN_TEST(int_construction);
    RUN_TEST(int_arithmetic_operations);
    RUN_TEST(int_comparison_operations);
    RUN_TEST(int_bitwise_operations);
    RUN_TEST(int_properties);
    RUN_TEST(int_methods);
    
    // Double 类型测试
    std::cout << "\n--- Double 类型测试 ---" << std::endl;
    RUN_TEST(double_construction);
    RUN_TEST(double_arithmetic_operations);
    RUN_TEST(double_comparison_operations);
    RUN_TEST(double_methods);
    
    // Bool 类型测试
    std::cout << "\n--- Bool 类型测试 ---" << std::endl;
    RUN_TEST(bool_construction);
    RUN_TEST(bool_logical_operations);
    RUN_TEST(bool_comparison_operations);
    RUN_TEST(bool_methods);
    
    // 扩展操作符测试
    std::cout << "\n--- 扩展操作符测试 ---" << std::endl;
    RUN_TEST(increment_decrement_operators);
    RUN_TEST(compound_assignment_operators);
    RUN_TEST(double_increment_decrement);
    RUN_TEST(double_compound_assignment);
    
    // 异常处理测试
    std::cout << "\n--- 异常处理测试 ---" << std::endl;
    RUN_TEST(division_by_zero_exceptions);
    
    std::cout << "\n=== 所有测试通过! ===" << std::endl;
    return 0;
}
