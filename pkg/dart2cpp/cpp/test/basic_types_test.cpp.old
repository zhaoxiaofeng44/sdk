// ============================================================================
// C++ 基础数据类型测试用例
// 测试 Int、Double、Bool、String 等基础类型的功能
// 注意：使用联合体 ValueUnion 访问 .value.int_value, .value.double_value 等
// ============================================================================

#include "../core/dart2cpp.h"
#include <iostream>
#include <cassert>
#include <cmath>
#include <stdexcept>

// 简单的测试框架
#define TEST(name) \
    void test_##name(); \
    void test_##name()

#define ASSERT_EQ(expected, actual) \
    do { \
        if ((expected) != (actual)) { \
            std::cerr << "ASSERTION FAILED: " << #expected << " != " << #actual \
                      << " (expected: " << (expected) << ", actual: " << (actual) << ")" \
                      << " at " << __FILE__ << ":" << __LINE__ << std::endl; \
            std::abort(); \
        } \
    } while(0)

#define ASSERT_TRUE(condition) \
    do { \
        if (!(condition)) { \
            std::cerr << "ASSERTION FAILED: " << #condition << " is false" \
                      << " at " << __FILE__ << ":" << __LINE__ << std::endl; \
            std::abort(); \
        } \
    } while(0)

#define ASSERT_FALSE(condition) \
    do { \
        if (condition) { \
            std::cerr << "ASSERTION FAILED: " << #condition << " is true" \
                      << " at " << __FILE__ << ":" << __LINE__ << std::endl; \
            std::abort(); \
        } \
    } while(0)

#define ASSERT_NEAR(expected, actual, tolerance) \
    do { \
        if (std::abs((expected) - (actual)) > (tolerance)) { \
            std::cerr << "ASSERTION FAILED: " << #expected << " != " << #actual \
                      << " (expected: " << (expected) << ", actual: " << (actual) \
                      << ", tolerance: " << (tolerance) << ")" \
                      << " at " << __FILE__ << ":" << __LINE__ << std::endl; \
            std::abort(); \
        } \
    } while(0)

#define RUN_TEST(name) \
    do { \
        std::cout << "Running test_" << #name << "..." << std::endl; \
        test_##name(); \
        std::cout << "✓ test_" << #name << " passed" << std::endl; \
    } while(0)

// ============================================================================
// Int 类型测试
// ============================================================================

TEST(int_construction_and_access) {
    // 测试构造函数和联合体访问
    Int a(42);
    ASSERT_EQ(1, a.type_id);  // Int 类型ID为1
    ASSERT_EQ(42, a.value.int_value);  // 使用联合体访问
    ASSERT_EQ(42, a.getValue());  // 使用便捷方法访问
    ASSERT_EQ(42, a.toInt());  // 类型转换方法
    
    // 默认构造
    Int b;
    ASSERT_EQ(1, b.type_id);
    ASSERT_EQ(0, b.value.int_value);
    
    // 拷贝构造
    Int c(a);
    ASSERT_EQ(1, c.type_id);
    ASSERT_EQ(42, c.value.int_value);
}

TEST(int_assignment) {
    Int a(10);
    Int b(20);
    
    // 赋值操作
    a = b;
    ASSERT_EQ(20, a.value.int_value);
    ASSERT_EQ(20, b.value.int_value);
    
    // 从 Any 赋值
    Any any_val(30);
    a = any_val;
    ASSERT_EQ(30, a.value.int_value);
}

TEST(int_arithmetic_operations) {
    Int a(10);
    Int b(3);
    
    // 加法
    Int sum = a + b;
    ASSERT_EQ(13, sum.value.int_value);
    
    // 减法
    Int diff = a - b;
    ASSERT_EQ(7, diff.value.int_value);
    
    // 乘法
    Int product = a * b;
    ASSERT_EQ(30, product.value.int_value);
    
    // 除法
    Int quotient = a / b;
    ASSERT_EQ(3, quotient.value.int_value);
    
    // 取模
    Int remainder = a % b;
    ASSERT_EQ(1, remainder.value.int_value);
}

TEST(int_comparison_operations) {
    Int a(10);
    Int b(20);
    Int c(10);
    
    // 相等比较
    Bool eq1 = (a == c);
    ASSERT_TRUE(eq1.value.bool_value);
    
    Bool eq2 = (a == b);
    ASSERT_FALSE(eq2.value.bool_value);
    
    // 不等比较
    Bool ne1 = (a != b);
    ASSERT_TRUE(ne1.value.bool_value);
    
    Bool ne2 = (a != c);
    ASSERT_FALSE(ne2.value.bool_value);
    
    // 大小比较
    Bool lt = (a < b);
    ASSERT_TRUE(lt.value.bool_value);
    
    Bool gt = (b > a);
    ASSERT_TRUE(gt.value.bool_value);
    
    Bool le = (a <= c);
    ASSERT_TRUE(le.value.bool_value);
    
    Bool ge = (b >= a);
    ASSERT_TRUE(ge.value.bool_value);
}

TEST(int_dart_methods) {
    Int negative(-5);
    Int positive(5);
    Int zero(0);
    
    // abs() 方法
    Int abs_neg = negative.abs();
    ASSERT_EQ(5, abs_neg.value.int_value);
    
    Int abs_pos = positive.abs();
    ASSERT_EQ(5, abs_pos.value.int_value);
    
    // 符号属性
    Int sign_neg = negative.get_sign();
    ASSERT_EQ(-1, sign_neg.value.int_value);
    
    Int sign_pos = positive.get_sign();
    ASSERT_EQ(1, sign_pos.value.int_value);
    
    Int sign_zero = zero.get_sign();
    ASSERT_EQ(0, sign_zero.value.int_value);
    
    // 奇偶性检查
    Int even(4);
    Int odd(5);
    
    Bool is_even = even.get_isEven();
    ASSERT_TRUE(is_even.value.bool_value);
    
    Bool is_odd = odd.get_isOdd();
    ASSERT_TRUE(is_odd.value.bool_value);
    
    Bool not_even = odd.get_isEven();
    ASSERT_FALSE(not_even.value.bool_value);
}

// ============================================================================
// Double 类型测试
// ============================================================================

TEST(double_construction_and_access) {
    // 测试构造函数和联合体访问
    Double a(3.14);
    ASSERT_EQ(2, a.type_id);  // Double 类型ID为2
    ASSERT_NEAR(3.14, a.value.double_value, 0.001);  // 使用联合体访问
    ASSERT_NEAR(3.14, a.getValue(), 0.001);  // 使用便捷方法访问
    ASSERT_NEAR(3.14, a.toDouble(), 0.001);  // 类型转换方法
    
    // 默认构造
    Double b;
    ASSERT_EQ(2, b.type_id);
    ASSERT_NEAR(0.0, b.value.double_value, 0.001);
    
    // 从 Int 构造
    Int int_val(42);
    Double c(int_val);
    ASSERT_EQ(2, c.type_id);
    ASSERT_NEAR(42.0, c.value.double_value, 0.001);
}

TEST(double_arithmetic_operations) {
    Double a(10.5);
    Double b(3.2);
    
    // 加法
    Double sum = a + b;
    ASSERT_NEAR(13.7, sum.value.double_value, 0.001);
    
    // 减法
    Double diff = a - b;
    ASSERT_NEAR(7.3, diff.value.double_value, 0.001);
    
    // 乘法
    Double product = a * b;
    ASSERT_NEAR(33.6, product.value.double_value, 0.001);
    
    // 除法
    Double quotient = a / b;
    ASSERT_NEAR(3.28125, quotient.value.double_value, 0.001);
}

TEST(double_comparison_operations) {
    Double a(10.5);
    Double b(20.7);
    Double c(10.5);
    
    // 相等比较
    Bool eq1 = (a == c);
    ASSERT_TRUE(eq1.value.bool_value);
    
    Bool eq2 = (a == b);
    ASSERT_FALSE(eq2.value.bool_value);
    
    // 大小比较
    Bool lt = (a < b);
    ASSERT_TRUE(lt.value.bool_value);
    
    Bool gt = (b > a);
    ASSERT_TRUE(gt.value.bool_value);
}

TEST(double_dart_methods) {
    Double negative(-5.7);
    Double positive(5.7);
    
    // abs() 方法
    Double abs_neg = negative.abs();
    ASSERT_NEAR(5.7, abs_neg.value.double_value, 0.001);
    
    // floor, ceil, round 方法
    Double val(3.7);
    Double floor_val = val.floor();
    ASSERT_NEAR(3.0, floor_val.value.double_value, 0.001);
    
    Double ceil_val = val.ceil();
    ASSERT_NEAR(4.0, ceil_val.value.double_value, 0.001);
    
    Double round_val = val.round();
    ASSERT_NEAR(4.0, round_val.value.double_value, 0.001);
    
    // toInt 转换
    Int int_val = val.toInt();
    ASSERT_EQ(3, int_val.value.int_value);
}

// ============================================================================
// Bool 类型测试
// ============================================================================

TEST(bool_construction_and_access) {
    // 测试构造函数和联合体访问
    Bool a(true);
    ASSERT_EQ(3, a.type_id);  // Bool 类型ID为3
    ASSERT_TRUE(a.value.bool_value);  // 使用联合体访问
    ASSERT_TRUE(a.getValue());  // 使用便捷方法访问
    ASSERT_TRUE(a.toBool());  // 类型转换方法
    
    Bool b(false);
    ASSERT_EQ(3, b.type_id);
    ASSERT_FALSE(b.value.bool_value);
    
    // 默认构造
    Bool c;
    ASSERT_EQ(3, c.type_id);
    ASSERT_FALSE(c.value.bool_value);
}

TEST(bool_logical_operations) {
    Bool true_val(true);
    Bool false_val(false);
    
    // 逻辑与
    Bool and_result1 = true_val && true_val;
    ASSERT_TRUE(and_result1.value.bool_value);
    
    Bool and_result2 = true_val && false_val;
    ASSERT_FALSE(and_result2.value.bool_value);
    
    // 逻辑或
    Bool or_result1 = true_val || false_val;
    ASSERT_TRUE(or_result1.value.bool_value);
    
    Bool or_result2 = false_val || false_val;
    ASSERT_FALSE(or_result2.value.bool_value);
    
    // 逻辑非
    Bool not_result1 = !true_val;
    ASSERT_FALSE(not_result1.value.bool_value);
    
    Bool not_result2 = !false_val;
    ASSERT_TRUE(not_result2.value.bool_value);
}

TEST(bool_comparison_operations) {
    Bool true_val(true);
    Bool false_val(false);
    Bool another_true(true);
    
    // 相等比较
    Bool eq1 = (true_val == another_true);
    ASSERT_TRUE(eq1.value.bool_value);
    
    Bool eq2 = (true_val == false_val);
    ASSERT_FALSE(eq2.value.bool_value);
    
    // 不等比较
    Bool ne1 = (true_val != false_val);
    ASSERT_TRUE(ne1.value.bool_value);
    
    Bool ne2 = (true_val != another_true);
    ASSERT_FALSE(ne2.value.bool_value);
}

TEST(bool_type_conversion) {
    Bool true_val(true);
    Bool false_val(false);
    
    // 转换为 Int
    Int true_int = true_val.toInt();
    ASSERT_EQ(1, true_int.value.int_value);
    
    Int false_int = false_val.toInt();
    ASSERT_EQ(0, false_int.value.int_value);
    
    // 作为条件使用
    if (true_val) {
        // 应该执行到这里
        ASSERT_TRUE(true);
    } else {
        ASSERT_TRUE(false);  // 不应该执行到这里
    }
    
    if (false_val) {
        ASSERT_TRUE(false);  // 不应该执行到这里
    } else {
        // 应该执行到这里
        ASSERT_TRUE(true);
    }
}

// ============================================================================
// String 类型测试
// ============================================================================

TEST(string_construction_and_access) {
    // 测试构造函数和联合体访问
    String a("Hello");
    ASSERT_EQ(4, a.type_id);  // String 类型ID为4
    // String 使用字符串池，通过 string_index 访问
    ASSERT_TRUE(a.value.string_index >= 0);
    ASSERT_EQ("Hello", a.getValue());
    
    // 从 std::string 构造
    std::string std_str = "World";
    String b(std_str);
    ASSERT_EQ(4, b.type_id);
    ASSERT_EQ("World", b.getValue());
    
    // 默认构造
    String c;
    ASSERT_EQ(4, c.type_id);
    ASSERT_EQ("", c.getValue());
}

TEST(string_concatenation) {
    String a("Hello");
    String b(" ");
    String c("World");
    
    // 字符串连接
    String result1 = a + b;
    ASSERT_EQ("Hello ", result1.getValue());
    
    String result2 = a + b + c;
    ASSERT_EQ("Hello World", result2.getValue());
}

TEST(string_comparison_operations) {
    String a("apple");
    String b("banana");
    String c("apple");
    
    // 相等比较
    Bool eq1 = (a == c);
    ASSERT_TRUE(eq1.value.bool_value);
    
    Bool eq2 = (a == b);
    ASSERT_FALSE(eq2.value.bool_value);
    
    // 字符串字面量比较
    Bool eq3 = (a == "apple");
    ASSERT_TRUE(eq3.value.bool_value);
    
    // 大小比较
    Bool lt = (a < b);
    ASSERT_TRUE(lt.value.bool_value);
    
    Bool gt = (b > a);
    ASSERT_TRUE(gt.value.bool_value);
}

TEST(string_dart_methods) {
    String str("Hello World");
    
    // length 属性
    Int len = str.get_length();
    ASSERT_EQ(11, len.value.int_value);
    
    // isEmpty 属性
    Bool is_empty = str.get_isEmpty();
    ASSERT_FALSE(is_empty.value.bool_value);
    
    String empty_str("");
    Bool empty_check = empty_str.get_isEmpty();
    ASSERT_TRUE(empty_check.value.bool_value);
    
    // isNotEmpty 属性
    Bool is_not_empty = str.get_isNotEmpty();
    ASSERT_TRUE(is_not_empty.value.bool_value);
    
    // substring 方法
    String sub = str.substring(Int(0), Int(5));
    ASSERT_EQ("Hello", sub.getValue());
    
    // toLowerCase 和 toUpperCase
    String lower = str.toLowerCase();
    ASSERT_EQ("hello world", lower.getValue());
    
    String upper = str.toUpperCase();
    ASSERT_EQ("HELLO WORLD", upper.getValue());
}

TEST(string_search_methods) {
    String str("Hello World Hello");
    String pattern("Hello");
    String not_found("xyz");
    
    // indexOf 方法
    Int first_index = str.indexOf(pattern);
    ASSERT_EQ(0, first_index.value.int_value);
    
    Int second_index = str.indexOf(pattern, Int(1));
    ASSERT_EQ(12, second_index.value.int_value);
    
    Int not_found_index = str.indexOf(not_found);
    ASSERT_EQ(-1, not_found_index.value.int_value);
    
    // contains 方法
    Bool contains_hello = str.contains(pattern);
    ASSERT_TRUE(contains_hello.value.bool_value);
    
    Bool contains_xyz = str.contains(not_found);
    ASSERT_FALSE(contains_xyz.value.bool_value);
    
    // startsWith 和 endsWith
    Bool starts_with = str.startsWith(String("Hello"));
    ASSERT_TRUE(starts_with.value.bool_value);
    
    Bool ends_with = str.endsWith(String("Hello"));
    ASSERT_TRUE(ends_with.value.bool_value);
}

// ============================================================================
// 类型转换和混合运算测试
// ============================================================================

TEST(type_conversion_between_types) {
    // Int 到 Double
    Int int_val(42);
    Double double_from_int = int_val.toDouble();
    ASSERT_NEAR(42.0, double_from_int.value.double_value, 0.001);
    
    // Double 到 Int
    Double double_val(3.7);
    Int int_from_double = double_val.toInt();
    ASSERT_EQ(3, int_from_double.value.int_value);
    
    // Bool 到 Int
    Bool true_val(true);
    Bool false_val(false);
    Int int_from_true = true_val.toInt();
    Int int_from_false = false_val.toInt();
    ASSERT_EQ(1, int_from_true.value.int_value);
    ASSERT_EQ(0, int_from_false.value.int_value);
    
    // Int 到 Bool
    Int zero(0);
    Int non_zero(5);
    Bool bool_from_zero = zero.toBool();
    Bool bool_from_non_zero = non_zero.toBool();
    ASSERT_FALSE(bool_from_zero.value.bool_value);
    ASSERT_TRUE(bool_from_non_zero.value.bool_value);
}

TEST(mixed_arithmetic_operations) {
    Int int_val(10);
    Double double_val(3.5);
    
    // Int + Double
    Double result1 = int_val + double_val;
    ASSERT_NEAR(13.5, result1.value.double_value, 0.001);
    
    // Int - Double
    Double result2 = int_val - double_val;
    ASSERT_NEAR(6.5, result2.value.double_value, 0.001);
    
    // Int * Double
    Double result3 = int_val * double_val;
    ASSERT_NEAR(35.0, result3.value.double_value, 0.001);
    
    // Int / Double
    Double result4 = int_val / double_val;
    ASSERT_NEAR(2.857, result4.value.double_value, 0.001);
}

// ============================================================================
// 边界情况和错误处理测试
// ============================================================================

TEST(division_by_zero_handling) {
    Int dividend(10);
    Int zero(0);
    
    // 整数除零应该抛出异常
    bool caught_division_error = false;
    try {
        Int result = dividend / zero;
    } catch (const std::runtime_error& e) {
        caught_division_error = true;
    }
    ASSERT_TRUE(caught_division_error);
    
    // 取模除零也应该抛出异常
    bool caught_modulo_error = false;
    try {
        Int result = dividend % zero;
    } catch (const std::runtime_error& e) {
        caught_modulo_error = true;
    }
    ASSERT_TRUE(caught_modulo_error);
}

TEST(null_value_handling) {
    // 测试 Null 和 Void 值
    Int null_int(Null);
    ASSERT_EQ(0, null_int.type_id);  // Null 类型ID为0
    
    Double null_double(Null);
    ASSERT_EQ(0, null_double.type_id);
    
    Bool null_bool(Null);
    ASSERT_EQ(0, null_bool.type_id);
    
    String null_string(Null);
    ASSERT_EQ(0, null_string.type_id);
}

TEST(large_number_handling) {
    // 测试大数值
    Int max_int(INT_MAX);
    ASSERT_EQ(INT_MAX, max_int.value.int_value);
    
    Int min_int(INT_MIN);
    ASSERT_EQ(INT_MIN, min_int.value.int_value);
    
    // 测试浮点数特殊值
    Double positive_inf(std::numeric_limits<double>::infinity());
    Bool is_infinite = positive_inf.get_isInfinite();
    ASSERT_TRUE(is_infinite.value.bool_value);
    
    Double nan_val(std::numeric_limits<double>::quiet_NaN());
    Bool is_nan = nan_val.get_isNaN();
    ASSERT_TRUE(is_nan.value.bool_value);
}

// ============================================================================
// 主函数
// ============================================================================

int main() {
    std::cout << "=== 基础数据类型测试开始 ===" << std::endl;
    std::cout << std::endl;
    
    std::cout << "--- Int 类型测试 ---" << std::endl;
    RUN_TEST(int_construction_and_access);
    RUN_TEST(int_assignment);
    RUN_TEST(int_arithmetic_operations);
    RUN_TEST(int_comparison_operations);
    RUN_TEST(int_dart_methods);
    std::cout << std::endl;
    
    std::cout << "--- Double 类型测试 ---" << std::endl;
    RUN_TEST(double_construction_and_access);
    RUN_TEST(double_arithmetic_operations);
    RUN_TEST(double_comparison_operations);
    RUN_TEST(double_dart_methods);
    std::cout << std::endl;
    
    std::cout << "--- Bool 类型测试 ---" << std::endl;
    RUN_TEST(bool_construction_and_access);
    RUN_TEST(bool_logical_operations);
    RUN_TEST(bool_comparison_operations);
    RUN_TEST(bool_type_conversion);
    std::cout << std::endl;
    
    std::cout << "--- String 类型测试 ---" << std::endl;
    RUN_TEST(string_construction_and_access);
    RUN_TEST(string_concatenation);
    RUN_TEST(string_comparison_operations);
    RUN_TEST(string_dart_methods);
    RUN_TEST(string_search_methods);
    std::cout << std::endl;
    
    std::cout << "--- 类型转换和混合运算测试 ---" << std::endl;
    RUN_TEST(type_conversion_between_types);
    RUN_TEST(mixed_arithmetic_operations);
    std::cout << std::endl;
    
    std::cout << "--- 边界情况和错误处理测试 ---" << std::endl;
    RUN_TEST(division_by_zero_handling);
    RUN_TEST(null_value_handling);
    RUN_TEST(large_number_handling);
    std::cout << std::endl;
    
    std::cout << "=== 所有基础数据类型测试通过! ===" << std::endl;
    
    return 0;
}
